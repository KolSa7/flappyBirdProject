<Window x:Class="flappyBirdProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:flappyBirdProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800"
        Focusable="True" Loaded="Window_Loaded"
        PreviewKeyDown="OnKeyDownHandler">
    <Grid Background="#FF00EAFB">
        <Canvas x:Name="game" Width="800">
            <Button x:Name="player" Canvas.Left="50" Canvas.Top="250" Width="50" Height="25">bird</Button>
            <Rectangle Height="400" Canvas.Left="800" Canvas.Top="-200" Stroke="Black" Width="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Rectangle Height="400" Canvas.Left="800" Canvas.Top="300"   Stroke="Black" Width="50" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Rectangle Height="400" Canvas.Left="650" Canvas.Top="-200" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="650" Canvas.Top="300" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="500" Canvas.Top="-200" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="500" Canvas.Top="300" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="350" Canvas.Top="-200" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="350" Canvas.Top="300" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="200" Canvas.Top="-200" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Rectangle Height="400" Canvas.Left="200" Canvas.Top="300" Stroke="Black" Width="50" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Canvas>
    </Grid>
</Window>
