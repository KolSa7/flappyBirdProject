<Window x:Class="flappyBirdProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:flappyBirdProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800"
        Focusable="True" Loaded="Window_Loaded"
        PreviewKeyDown="OnKeyDownHandler">
    <Grid Background="#FF00EAFB">
        <Canvas x:Name="game">

            <Button x:Name="player" Canvas.Left="50" Canvas.Top="250">bird</Button>
            <StackPanel Canvas.Left="750" x:Name="obstacle">
                <Rectangle Height="100" Width="50" Fill="#FF00FF27"/>
                <Rectangle Height="100" Width="50" Fill="#FF00FF27"/>
                <Rectangle Height="100" Width="50" x:Name="gap"/>
                <Rectangle Height="100" Width="50" Fill="#FF00FF27"/>
                <Rectangle Height="100" Width="50" Fill="#FF00FF27"/>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
